{
  "name": "setpoint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "npm run build && npm run preview:host",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios": "npm --prefix native run ios",
    "android": "npm --prefix native run android",
    "web": "npm --prefix native run web",
    "start": "vite",
    "start:native": "npm --prefix native start",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm --prefix native run typecheck"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
